# ---------------------------------------------------------------------------
# Скопируйте этот файл в .env и заполните значения. .env в git не попадает.
# ---------------------------------------------------------------------------

# --- Telegram -------------------------------------------------------------
# Токен от @BotFather (Bot API token)
TELEGRAM_TOKEN=123456789:AAExampleTokenFromBotFather

# --- Доступ ---------------------------------------------------------------
# Telegram user id владельца. Можно несколько через запятую: 123456789,987654321
# Узнать свой id: оставьте значение пустым, напишите боту — он ответит вашим id.
OWNER_ID=123456789

# --- DeepSeek -------------------------------------------------------------
# Ключ с platform.deepseek.com -> API keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
REQUEST_TIMEOUT=90

# --- Канал ----------------------------------------------------------------
# @username канала или числовой id вида -1001234567890.
# Оставьте пустым, если нужны только ручные генерации без публикации.
CHANNEL_ID=@my_sport_channel

# --- Автопостинг ----------------------------------------------------------
AUTOPOST_ENABLED=true
# Интервал в часах (0.25 = 15 минут). Используется, если POST_TIMES пуст.
POST_INTERVAL_HOURS=6
# Расписание по времени: "07:00,19:00". Если заполнено — интервал игнорируется.
POST_TIMES=07:00,19:00
TIMEZONE=Europe/Moscow

# --- Картинки (GigaChat / Kandinsky) -------------------------------------
# Authorization key из личного кабинета developers.sber.ru
GIGACHAT_AUTH_KEY=your-gigachat-authorization-key
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# --- Подписка -------------------------------------------------------------
# Цена за период в звёздах Telegram (XTR)
SUBSCRIPTION_PRICE_STARS=250
SUBSCRIPTION_DAYS=30
TRIAL_DAYS=7
# false — счета не выставляются, пока платные функции не готовы
SALES_ENABLED=false
DB_PATH=fitbot.db
SUPPORT_CONTACT=@your_support

# --- Ручная оплата переводом ----------------------------------------------
# qr  — показываем QR СБП из «Мой налог» (файл PAYMENT_QR_PATH) и/или ссылку
# card — показываем номер карты и получателя
PAYMENT_MODE=qr
# Ссылка из «Мой налог» (qr.nspk.ru/...) — бот покажет её кнопкой, QR-файл не нужен
PAYMENT_LINK=
# Необязательно: своя картинка QR, если хотите показывать её вдобавок к ссылке
PAYMENT_QR_PATH=payment_qr.png
CARD_NUMBER=
CARD_HOLDER=
SUBSCRIPTION_PRICE_RUB=349
# Сколько тренировок на одном весе нужно до повышения нагрузки
PROGRESSION_SESSIONS=2
SUBSCRIPTION_PRICE_3M=899
SUBSCRIPTION_PRICE_1Y=2990
# Купон на первую оплату: процент и срок жизни в днях
COUPON_PERCENT=50
COUPON_DAYS=7
# Заявка живёт столько минут, потом её нужно оформлять заново
ORDER_TTL_MINUTES=60

# --- Мини-апп -------------------------------------------------------------
# Публичный HTTPS-адрес, по которому открывается webapp/index.html.
# Telegram пускает только HTTPS. Если хостинг не отдаёт порт наружу,
# нужен туннель (cloudflared/ngrok) или отдельный VPS.
WEBAPP_URL=
# Порт, на котором бот поднимает aiohttp-сервер. 0 — не запускать.
# Если хостинг выдаёт адрес вида bot-<id>-<port>-<user>.bothost.tech,
# указывайте именно этот порт (обычно 5000). Если WEBAPP_PORT пуст,
# берётся переменная PORT, которую PaaS выставляют сами.
WEBAPP_PORT=5000

# --- Картинка и пост ------------------------------------------------------
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_TIMEOUT=90
# Проверка результата генерации перед публикацией
IMAGE_VALIDATE=true
IMAGE_MIN_SIDE=512
IMAGE_MAX_SIDE=4096
IMAGE_MIN_BYTES=10000
IMAGE_MIN_STD=5
# Смысловая проверка картинки моделью (искажения, текст, несоответствие теме)
IMAGE_VISION=true
GIGACHAT_VISION_MODEL=GigaChat-2-Max
GIGACHAT_VISION_TIMEOUT=60
POST_MIN_CHARS=250
POST_MAX_CHARS=400

# --- Прочее ---------------------------------------------------------------
LOG_LEVEL=INFO
